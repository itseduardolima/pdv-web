# ===== VPS (docker compose) — copie para .env e preencha com valores reais =====

# Domínios (aponte no DNS: A/AAAA de APP_DOMAIN, *.APP_DOMAIN, API_DOMAIN e MEDIA_DOMAIN para a VPS)
APP_DOMAIN=app.seudominio.com.br
API_DOMAIN=api.seudominio.com.br
MEDIA_DOMAIN=media.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# Postgres: superusuário (admin/backup) e usuário da aplicação (sem superusuário — RLS)
POSTGRES_PASSWORD=gere-uma-senha-longa
APP_DB_USER=pdv
APP_DB_PASSWORD=gere-outra-senha-longa
APP_DB_NAME=pdv

# MinIO (fotos e logos)
STORAGE_ACCESS_KEY=pdv
STORAGE_SECRET_KEY=gere-uma-senha-longa-para-o-minio
STORAGE_BUCKET=pdv-media
STORAGE_REGION=us-east-1

# apps/api
SESSION_SECRET=gere-um-segredo-longo-e-aleatorio   # openssl rand -hex 32
SESSION_TTL_HOURS=12
TENANT_CACHE_TTL_MS=60000

# Painel Superadmin (Épico 13) — host reservado que nunca resolve tenant.
# PLATFORM_HOST precisa ser o mesmo valor em api e web (docker-compose.yml
# já propaga pros dois a partir desta variável).
PLATFORM_HOST=admin.app.seudominio.com.br
PLATFORM_SESSION_SECRET=gere-um-segredo-diferente-do-session-secret   # openssl rand -hex 32
PLATFORM_SESSION_TTL_HOURS=8
# Só usados pelo seed — bootstrap do primeiro superadmin (idempotente por
# e-mail). Sem eles, o seed não cria/atualiza nenhum PlatformAdmin.
# SEED_PLATFORM_ADMIN_EMAIL=voce@seudominio.com.br
# SEED_PLATFORM_ADMIN_PASSWORD=troque-depois-do-primeiro-login
# SEED_PLATFORM_ADMIN_NAME=Seu Nome

# E-mail transacional (primeiro acesso / esqueci meu PIN) — provedor SMTP externo
MAIL_TRANSPORT=smtp
MAIL_FROM=Mercadinho <no-reply@seudominio.com.br>
SMTP_HOST=smtp.provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
