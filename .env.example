# ===== VPS (docker compose) — copie para .env e preencha com valores reais =====

# Domínios (aponte no DNS: A/AAAA de APP_DOMAIN, *.APP_DOMAIN, API_DOMAIN e MEDIA_DOMAIN para a VPS)
APP_DOMAIN=app.seudominio.com.br
API_DOMAIN=api.seudominio.com.br
MEDIA_DOMAIN=media.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# Postgres: superusuário (admin/backup) e usuário da aplicação (sem superusuário — RLS)
POSTGRES_PASSWORD=gere-uma-senha-longa
APP_DB_USER=pdv
APP_DB_PASSWORD=gere-outra-senha-longa
APP_DB_NAME=pdv

# MinIO (fotos e logos)
STORAGE_ACCESS_KEY=pdv
STORAGE_SECRET_KEY=gere-uma-senha-longa-para-o-minio
STORAGE_BUCKET=pdv-media
STORAGE_REGION=us-east-1

# apps/api
SESSION_SECRET=gere-um-segredo-longo-e-aleatorio   # openssl rand -hex 32
SESSION_TTL_HOURS=12
TENANT_CACHE_TTL_MS=60000

# E-mail transacional (primeiro acesso / esqueci meu PIN) — provedor SMTP externo
MAIL_TRANSPORT=smtp
MAIL_FROM=Mercadinho <no-reply@seudominio.com.br>
SMTP_HOST=smtp.provedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
