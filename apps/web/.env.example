# Em dev o browser usa o rewrite /api -> API_INTERNAL_URL (ver next.config.mjs);
# em produção NEXT_PUBLIC_API_URL é a URL pública da API (ver .env.example da raiz).
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://localhost:3001

# Domínio base dos subdomínios de loja (<slug>.NEXT_PUBLIC_APP_BASE_DOMAIN) —
# mesmo valor de APP_BASE_DOMAIN na API (apps/api/.env.example). Usado só
# pra exibir o endereço no painel Superadmin.
NEXT_PUBLIC_APP_BASE_DOMAIN=app.localhost:3000
