DATABASE_URL=postgresql://pdv:pdv@localhost:5432/pdv?schema=public
PORT=3001
SESSION_SECRET=change-me-to-a-long-random-secret
SESSION_TTL_HOURS=12
CORS_ORIGIN=http://localhost:3000
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=pdv
STORAGE_SECRET_KEY=pdvpdvpdv
STORAGE_BUCKET=pdv-media
STORAGE_REGION=us-east-1
# Domínio base dos subdomínios de tenant: <slug>.APP_BASE_DOMAIN
APP_BASE_DOMAIN=app.localhost
TENANT_CACHE_TTL_MS=60000
NODE_ENV=development
STORAGE_PUBLIC_URL=http://localhost:9000/pdv-media
# Rate limit global (08-seguranca.md § 5) fica ligado por padrão em todo
# ambiente (o código assume 'true' se a env não existir). Só em dev local
# desligamos, para uma sessão de testes manuais/E2E repetidos não travar em
# 429 — nunca comitar isso como 'false' num .env de produção.
RATE_LIMIT_ENABLED=false
# E-mail (primeiro acesso / esqueci meu PIN). `log` só escreve o link no
# console da API — padrão em dev e testes. Em produção use `smtp` com um
# provedor externo (09-operacao § 8) e preencha SMTP_*.
MAIL_TRANSPORT=log
MAIL_FROM=PDV <no-reply@localhost>
# SMTP_HOST=smtp.provedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Origem pública da loja no link do e-mail: {host} vira <slug>.APP_BASE_DOMAIN ou o domínio próprio.
WEB_ORIGIN_TEMPLATE=http://{host}:3000
# Painel Superadmin (Épico 13) — conta do dono do sistema, fora de qualquer
# tenant. PLATFORM_HOST é o host reservado que não tenta resolver tenant
# nenhum (excluído do TenantMiddleware); nunca pode coincidir com um slug de
# loja. Segredo de sessão separado do SESSION_SECRET de propósito — um
# vazamento de um não deve conseguir forjar sessão do outro.
PLATFORM_HOST=admin.app.localhost
PLATFORM_SESSION_SECRET=change-me-to-a-different-long-random-secret
PLATFORM_SESSION_TTL_HOURS=8
# Só usados pelo seed (pnpm db:seed) — bootstrap do primeiro superadmin.
# Sem eles, o seed não cria/atualiza nenhum PlatformAdmin.
# SEED_PLATFORM_ADMIN_EMAIL=voce@example.com
# SEED_PLATFORM_ADMIN_PASSWORD=troque-depois-do-primeiro-login
# SEED_PLATFORM_ADMIN_NAME=Seu Nome
