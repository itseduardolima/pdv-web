generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OperatorRole {
  ADMIN
  OPERATOR
}

enum PaymentMethod {
  CASH
  CARD
  PIX
}

enum ProductUnit {
  UN
  KG
  L
  PCT
  CX
}

// Conta do dono do sistema (revendedor) — fora do isolamento por tenant, de
// propósito (mesmo padrão de Tenant: não tem tenantId, não entra na
// migration de Row-Level Security). Não é um Operator: gerencia lojas, não
// pertence a nenhuma.
model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  resetTokens PlatformAdminResetToken[]
}

// "Esqueci minha senha" do superadmin — mesma mecânica de PinToken
// (token aleatório, só o hash SHA-256 salvo, uso único), mas fora do
// isolamento por tenant/RLS: mesma exceção deliberada de PlatformAdmin.
model PlatformAdminResetToken {
  id              String    @id @default(cuid())
  platformAdminId String
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
}

model Tenant {
  id              String   @id @default(cuid())
  slug            String   @unique
  domain          String?  @unique
  name            String
  logoUrl         String?
  primaryColor    String   @default("#e6e51e")
  primaryInkColor String?
  accentColor     String   @default("#466cf3")
  // Fuso da loja: define o que é "hoje" no Dashboard (IANA, ex. America/Sao_Paulo).
  timezone        String   @default("America/Sao_Paulo")
  // Quantidade de caixas físicos da loja (HU 4.5-4.7, 11.6). 1 = comportamento
  // de v1 (um único caixa lógico), sem seletor de caixa na UI.
  registerCount   Int      @default(1)
  createdAt       DateTime @default(now())
  // HU 13.7: suspender sem apagar dado nenhum — false bloqueia acesso (403
  // TENANT_SUSPENDED no TenantMiddleware), reativar restaura na hora.
  active          Boolean  @default(true)

  operators    Operator[]
  products     Product[]
  cashSessions CashSession[]
  sales        Sale[]
}

model Operator {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  role      OperatorRole @default(OPERATOR)
  // Nulo = primeiro acesso pendente: o operador define o PIN pelo link do e-mail.
  pinHash   String?
  // Opcional; obrigatório para Administrador (recuperação do PIN). Único por tenant.
  email     String?
  active    Boolean      @default(true)
  photoUrl  String?
  createdAt DateTime     @default(now())
  deletedAt DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  cashSessions CashSession[]
  sales        Sale[]
  pinTokens    PinToken[]

  @@unique([tenantId, email])
  @@index([tenantId, active])
}

enum PinTokenPurpose {
  FIRST_ACCESS
  RESET
}

// Link de "primeiro acesso" / "esqueci o PIN": guarda só o hash do token,
// uso único, com validade curta (08-seguranca § 4).
model PinToken {
  id         String          @id @default(cuid())
  tenantId   String
  operatorId String
  tokenHash  String          @unique
  purpose    PinTokenPurpose
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime        @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([tenantId, operatorId])
}

model Product {
  id             String      @id @default(cuid())
  tenantId       String
  name           String
  category       String
  unit           ProductUnit @default(UN)
  barcode        String?
  salePriceCents Int
  costPriceCents Int         @default(0)
  stockQuantity  Int         @default(0)
  minStock       Int         @default(5)
  photoUrl       String?
  createdAt      DateTime    @default(now())
  deletedAt      DateTime?

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  items  SaleItem[]

  @@unique([tenantId, barcode])
  @@index([tenantId, category])
  @@index([tenantId, name])
}

model CashSession {
  id                 String    @id @default(cuid())
  tenantId           String
  // Caixa físico (1..tenant.registerCount). HU 4.5: até tenant.registerCount
  // sessões abertas simultaneamente no mesmo tenant, uma por registerNumber.
  registerNumber     Int       @default(1)
  openedById         String
  openingAmountCents Int
  note               String?
  openedAt           DateTime  @default(now())
  closedAt           DateTime?
  totalCashCents     Int?
  totalCardCents     Int?
  totalPixCents      Int?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  openedBy Operator @relation(fields: [openedById], references: [id])
  sales    Sale[]

  @@index([tenantId, registerNumber, closedAt])
}

model Sale {
  id            String        @id @default(cuid())
  uuid          String
  tenantId      String
  cashSessionId String
  operatorId    String
  paymentMethod       PaymentMethod
  totalCents          Int
  // Troco: só em Dinheiro com valor recebido informado (03-regras-negocio § Venda).
  amountReceivedCents Int?
  changeCents         Int?
  soldAt              DateTime      @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  cashSession CashSession @relation(fields: [cashSessionId], references: [id])
  operator    Operator    @relation(fields: [operatorId], references: [id])
  items       SaleItem[]

  @@unique([tenantId, uuid])
  @@index([tenantId, soldAt])
  @@index([cashSessionId])
}

model SaleItem {
  id             String @id @default(cuid())
  saleId         String
  productId      String
  productName    String
  quantity       Int
  unitPriceCents Int

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
}
